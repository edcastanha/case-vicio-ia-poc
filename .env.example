# Copie para .env (nunca versionado). Backend por papel: api ou claude-code.
# A entrega final usa api nos três papéis (ADR 0002). claude-code usa o `claude -p`
# da assinatura e serve só para testes: os três papéis viram Claude e a independência se perde.
CLASSIFICADOR_BACKEND=api
VERIFICADOR_BACKEND=api
JUIZ_BACKEND=api

# Opcional: troca o modelo padrão de um papel (padrões em src/classificacao/entrada/configuracao.py).
# CLASSIFICADOR_MODELO=claude-sonnet-5-5
# VERIFICADOR_MODELO=gemini-3.8-flash
# JUIZ_MODELO=deepseek-v4-pro
# EMBEDDINGS_MODELO=gemini-embedding-2

# Opcional: troca a versão do prompt de um papel (padrão em prompts/versoes.toml; ADR 0003).
# CLASSIFICADOR_PROMPT=v2

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
