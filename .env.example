# Copie para .env (nunca versionado). Backend por papel: api ou claude-code.
# claude-code usa o `claude -p` da sua assinatura: só para testes (ADR 0002).
CLASSIFICADOR_BACKEND=claude-code
VERIFICADOR_BACKEND=claude-code
JUIZ_BACKEND=claude-code

# Opcional: troca o modelo padrão de um papel.
# CLASSIFICADOR_MODELO=sonnet

# Chaves para o backend api.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
